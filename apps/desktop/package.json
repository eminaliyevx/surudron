{
  "name": "@surudron/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --filter @surudron/web build && electrobun build",
    "check-types": "tsc --noEmit",
    "dev": "electrobun dev --watch",
    "start": "bun run --filter @surudron/web build && WEBKIT_DISABLE_DMABUF_RENDERER=1 electrobun dev"
  },
  "dependencies": {
    "@surudron/env": "workspace:*",
    "@surudron/server": "workspace:*",
    "electrobun": "^1.18.1"
  },
  "devDependencies": {
    "@surudron/config": "workspace:*",
    "concurrently": "^9.2.1"
  }
}
