{
  "name": "@surudron/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@orpc/openapi": "^1.14.2",
    "@orpc/server": "^1.14.2",
    "@orpc/zod": "^1.14.2",
    "@serialport/parser-readline": "^13.0.0",
    "@surudron/api": "workspace:*",
    "@surudron/env": "workspace:*",
    "@surudron/shared": "workspace:*",
    "node-mavlink": "^2.3.0",
    "serialport": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@serialport/bindings-cpp": "^13.0.1",
    "@serialport/stream": "^13.0.0",
    "@surudron/config": "workspace:*",
    "tsdown": "^0.21.10"
  }
}
